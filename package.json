{
  "name": "google-health-sheet-sync",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "husky",
    "login": "clasp login",
    "deploy": "clasp push",
    "pull": "clasp pull",
    "open": "clasp open-script",
    "test": "make test TEST_ARGS=--unit",
    "lint": "make lint",
    "format": "make exec COMMAND='npm run format:internal'",
    "mutate": "make test TEST_ARGS=--mutation",
    "lint:internal": "prettier --check . && eslint --max-warnings 0 . && tsc --noEmit -p jsconfig.json",
    "format:internal": "prettier --write . && eslint --fix .",
    "test:internal": "node test/run.js",
    "mutate:internal": "node test/mutate.js",
    "check": "make check",
    "build": "make build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
