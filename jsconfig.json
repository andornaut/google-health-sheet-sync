{
  "compilerOptions": {
    "target": "ES2019",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "lib": ["ES2019"],
    "types": ["google-apps-script", "node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules"]
}
