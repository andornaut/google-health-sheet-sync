#!/bin/sh
set -eu
action=${1:-check}
git config --global url.https://github.com/.insteadOf ssh://git@github.com/
git config --global --add url.https://github.com/.insteadOf git@github.com:
HUSKY=0 npm ci --maxsockets=1 --no-audit --no-fund >&2
lint() {
    for script in tests/container/stock tests/container/check-stock; do bash -n "$script"; done
    for script in tests/container/node tests/container/markdown; do sh -n "$script"; done
    npm run lint
}
test_suite() {
    case "${1:-}" in
        "") npm test; npm run mutate ;;
        --unit) npm test ;;
        --mutation) npm run mutate ;;
        *) printf '%s\n' 'Use --unit or --mutation for focused tests.' >&2; return 2 ;;
    esac
}
build() {
    printf '%s\n' 'No build check is declared.' >&2
    return 2
}
case "${1:-check}" in
    check)
        lint
        test_suite
        ;;
    lint) lint ;;
    test)
        if [ "$#" -gt 2 ]; then exit 2; fi
        test_suite "${2:-}"
        ;;
    build) build ;;
    *) exit 2 ;;
esac
