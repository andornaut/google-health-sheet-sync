#!/bin/sh
set -eu

if [ ! -e node_modules ]; then
    if [ "${CHECK_WRITABLE:-0}" = 1 ]; then
        cp -R /opt/check/node_modules node_modules
    else
        ln -s /opt/check/node_modules node_modules
    fi
fi

task=${1:-check}
shift || true

case "$task" in
    check)
        for category in $CHECK_TASKS; do
            /opt/check/run "$category"
        done
        ;;
    lint)
        bash -n tests/container/run tests/container/staged tests/container/staged-git
        sh -n tests/container/check
        npm run lint:internal
        markdownlint-cli2
        ;;
    test)
        if [ "$#" -gt 1 ]; then
            printf '%s\n' 'Select at most one focused test category.' >&2
            exit 2
        fi
        case "${1:-}" in
            "")
                npm run test:internal
                npm run mutate:internal
                ;;
            --unit)
                npm run test:internal
                ;;
            --mutation)
                npm run mutate:internal
                ;;
            *)
                printf '%s\n' 'Use TEST_ARGS=--unit or TEST_ARGS=--mutation to select part of the test gate.' >&2
                exit 2
                ;;
        esac
        ;;
    build)
        printf '%s\n' 'No build check is declared.' >&2
        exit 2
        ;;
    exec)
        if [ "$#" -gt 0 ]; then
            exec "$@"
        fi
        if [ -z "${COMMAND:-}" ]; then
            printf '%s\n' 'Set COMMAND for make exec.' >&2
            exit 2
        fi
        exec sh -ec "$COMMAND"
        ;;
    *)
        printf '%s\n' "Unsupported check task: $task" >&2
        exit 2
        ;;
esac
